<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wildfly</groupId>
        <artifactId>wildfly-microprofile</artifactId>
        <version>26.1.3.Final.bravura-8</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>wildfly-microprofile-health-smallrye-integration-tests</artifactId>
    <packaging>jar</packaging>

    <name>WildFly: MicroProfile Health Extension Integration Tests</name>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- MicroProfile Health API -->
        <dependency>
            <groupId>org.eclipse.microprofile.health</groupId>
            <artifactId>microprofile-health-api</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Arquillian Dependencies -->
        <dependency>
            <groupId>org.jboss.arquillian.junit</groupId>
            <artifactId>arquillian-junit-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wildfly.arquillian</groupId>
            <artifactId>wildfly-arquillian-container-managed</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ShrinkWrap Dependencies -->
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-impl-base</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap.resolver</groupId>
            <artifactId>shrinkwrap-resolver-api-maven</artifactId>
            <version>3.1.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap.resolver</groupId>
            <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
            <version>3.1.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap.descriptors</groupId>
            <artifactId>shrinkwrap-descriptors-api-javaee</artifactId>
            <version>${version.org.jboss.shrinkwrap.descriptors}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap.descriptors</groupId>
            <artifactId>shrinkwrap-descriptors-impl-javaee</artifactId>
            <version>${version.org.jboss.shrinkwrap.descriptors}</version>
            <scope>test</scope>
        </dependency>

        <!-- HTTP Client for testing health endpoints -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JSON API for parsing health responses - needed for test compilation -->
        <dependency>
            <groupId>javax.json</groupId>
            <artifactId>javax.json-api</artifactId>
            <version>1.1.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>javax.json</artifactId>
            <version>1.1.4</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Health extension - declared as dependency so maven-dependency-plugin can copy it -->
        <!-- Exclusions to avoid transitive dependency resolution issues -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wildfly-microprofile-health-smallrye</artifactId>
            <version>26.1.3.Final</version>
            <type>jar</type>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-bad-dependencies</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-wildfly</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-dist</artifactId>
                                    <version>26.1.3.Final</version>
                                    <type>zip</type>
                                    <overWrite>false</overWrite>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                    <includes>**/*</includes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-health-extension-jar</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>wildfly-microprofile-health-smallrye</artifactId>
                                    <version>26.1.3.Final</version>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.directory}/wildfly-26.1.3.Final/modules/system/layers/base/org/wildfly/extension/microprofile/health-smallrye/main</outputDirectory>
                                    <destFileName>wildfly-microprofile-health-smallrye-26.1.3.Final.jar</destFileName>
                                    <overWrite>true</overWrite>
                                </artifactItem>
                            </artifactItems>
                            <skip>false</skip>
                            <stripVersion>false</stripVersion>
                            <failOnMissingArtifact>false</failOnMissingArtifact>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.google.code.maven-replacer-plugin</groupId>
                <artifactId>replacer</artifactId>
                <version>1.5.3</version>
                <executions>
                    <execution>
                        <id>add-slf4j-dependency-to-module-xml</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <file>${project.build.directory}/wildfly-26.1.3.Final/modules/system/layers/base/org/wildfly/extension/microprofile/health-smallrye/main/module.xml</file>
                            <replacements>
                                <replacement>
                                    <token><![CDATA[        <module name="javax.json.api"/>
    </dependencies>]]></token>
                                    <value><![CDATA[        <module name="javax.json.api"/>
        <module name="org.slf4j.impl"/>
        <module name="org.jboss.as.ee"/>
    </dependencies>]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-microprofile-health-extension-to-standalone-xml</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <file>${project.build.directory}/wildfly-26.1.3.Final/standalone/configuration/standalone.xml</file>
                            <replacements>
                                <!-- Remove duplicate extension if it exists -->
                                <replacement>
                                    <token><![CDATA[        <extension module="org.wildfly.extension.microprofile.health-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.health-smallrye"/>]]></token>
                                    <value><![CDATA[        <extension module="org.wildfly.extension.microprofile.health-smallrye"/>]]></value>
                                </replacement>
                                <!-- Add extension after opentracing if it doesn't exist -->
                                <replacement>
                                    <token><![CDATA[        <extension module="org.wildfly.extension.microprofile.opentracing-smallrye"/>
        <extension module="org.wildfly.extension.request-controller"/>]]></token>
                                    <value><![CDATA[        <extension module="org.wildfly.extension.microprofile.opentracing-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.health-smallrye"/>
        <extension module="org.wildfly.extension.request-controller"/>]]></value>
                                </replacement>
                                <!-- If extension already exists earlier (between config and jwt), remove the one we just added -->
                                <replacement>
                                    <token><![CDATA[        <extension module="org.wildfly.extension.microprofile.config-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.health-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.jwt-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.opentracing-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.health-smallrye"/>
        <extension module="org.wildfly.extension.request-controller"/>]]></token>
                                    <value><![CDATA[        <extension module="org.wildfly.extension.microprofile.config-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.health-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.jwt-smallrye"/>
        <extension module="org.wildfly.extension.microprofile.opentracing-smallrye"/>
        <extension module="org.wildfly.extension.request-controller"/>]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-microprofile-health-subsystem-to-standalone-xml</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <file>${project.build.directory}/wildfly-26.1.3.Final/standalone/configuration/standalone.xml</file>
                            <replacements>
                                <replacement>
                                    <token><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-opentracing-smallrye:3.0" default-tracer="jaeger">
            <jaeger-tracer name="jaeger">
                <sampler-configuration sampler-type="const" sampler-param="1.0"/>
            </jaeger-tracer>
        </subsystem>
        <subsystem xmlns="urn:jboss:domain:naming:2.0">]]></token>
                                    <value><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-opentracing-smallrye:3.0" default-tracer="jaeger">
            <jaeger-tracer name="jaeger">
                <sampler-configuration sampler-type="const" sampler-param="1.0"/>
            </jaeger-tracer>
        </subsystem>
        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>
        <subsystem xmlns="urn:jboss:domain:naming:2.0">]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>remove-duplicate-microprofile-health-subsystem-after-opentracing</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <file>${project.build.directory}/wildfly-26.1.3.Final/standalone/configuration/standalone.xml</file>
                            <replacements>
                                <!-- Remove duplicate subsystem that was added after opentracing ONLY if original exists earlier (between config and jwt) -->
                                <!-- This pattern checks if the original exists: config-smallrye -> health-smallrye -> jwt-smallrye -->
                                <replacement>
                                    <token><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-config-smallrye:2.0"/>
        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>
        <subsystem xmlns="urn:wildfly:microprofile-jwt-smallrye:1.0"/>
        <subsystem xmlns="urn:wildfly:microprofile-opentracing-smallrye:3.0" default-tracer="jaeger">
            <jaeger-tracer name="jaeger">
                <sampler-configuration sampler-type="const" sampler-param="1.0"/>
            </jaeger-tracer>
        </subsystem>
        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>
        <subsystem xmlns="urn:jboss:domain:naming:2.0">]]></token>
                                    <value><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-config-smallrye:2.0"/>
        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>
        <subsystem xmlns="urn:wildfly:microprofile-jwt-smallrye:1.0"/>
        <subsystem xmlns="urn:wildfly:microprofile-opentracing-smallrye:3.0" default-tracer="jaeger">
            <jaeger-tracer name="jaeger">
                <sampler-configuration sampler-type="const" sampler-param="1.0"/>
            </jaeger-tracer>
        </subsystem>
        <subsystem xmlns="urn:jboss:domain:naming:2.0">]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>remove-duplicate-microprofile-health-subsystem</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <file>${project.build.directory}/wildfly-26.1.3.Final/standalone/configuration/standalone.xml</file>
                            <replacements>
                                <!-- Remove duplicate subsystem if it exists -->
                                <replacement>
                                    <token><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>
        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>]]></token>
                                    <value><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>]]></value>
                                </replacement>
                                <!-- Also handle case where one doesn't have security-enabled -->
                                <replacement>
                                    <token><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0"/>
        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>]]></token>
                                    <value><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>]]></value>
                                </replacement>
                                <replacement>
                                    <token><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>
        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0"/>]]></token>
                                    <value><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>set-microprofile-health-security-disabled</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <file>${project.build.directory}/wildfly-26.1.3.Final/standalone/configuration/standalone.xml</file>
                            <replacements>
                                <replacement>
                                    <token><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0"/>]]></token>
                                    <value><![CDATA[        <subsystem xmlns="urn:wildfly:microprofile-health-smallrye:3.0" security-enabled="false"/>]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <jboss.install.dir>${project.build.directory}/wildfly-26.1.3.Final</jboss.install.dir>
                        <jboss.home>${project.build.directory}/wildfly-26.1.3.Final</jboss.home>
                        <module.path>${project.build.directory}/wildfly-26.1.3.Final/modules</module.path>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

